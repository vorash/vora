# Vora runner as a rootlesskit-wrapped systemd *user* service.
#
# Installed by `make install-rootless` into ~/.config/systemd/user/. The wrapper
# runs vora-runner inside a persistent rootlesskit user namespace so the gVisor
# backend (runsc Method 2) works without root.
[Unit]
Description=Vora runner (rootlesskit, gVisor-capable)
Documentation=https://github.com/vorash/vora
After=network.target
# With VORA_AUDIT_DSN set the runner refuses to start until the audit database
# is reachable. Keep retrying rather than tripping the default start limit (5
# starts in 10s), so a slow database means a late runner, not a dead one.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/bin/vora-rootless.sh
Restart=on-failure
RestartSec=2
TimeoutSec=0
Delegate=yes
KillMode=mixed

[Install]
WantedBy=default.target
