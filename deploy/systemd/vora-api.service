# Vora control plane (vora-api) as a system service.
#
# Installed as /etc/systemd/system/vora-api.service by the vora-ansible
# `vora_api` role, or by scripts/install-system.sh --api.
#
# Unlike the runner, the API needs no namespaces or mounts, so it gets ordinary
# hardening. It holds the secrets master key and the API DSN: /etc/vora/api.env
# must be 0600 root:root.
[Unit]
Description=Vora control plane (vora-api)
Documentation=https://github.com/vorash/vora
After=network-online.target
Wants=network-online.target
# The store is remote (PostgreSQL/Supabase) and its route may not exist yet: a
# direct Supabase DSN is IPv6-only, and IPv6 can take a minute to converge after
# a reboot. Retry instead of giving up, so a slow network means a late API, not
# a dead one (the default limit is 5 starts in 10s).
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/etc/vora/api.env
ExecStart=/usr/local/bin/vora-api
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
# The registry gRPC and HTTP listeners are plain TCP; no extra capabilities.
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
