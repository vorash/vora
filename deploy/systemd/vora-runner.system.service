# Vora runner as a system service.
#
# Installed as /etc/systemd/system/vora-runner.service by the vora-ansible
# `vora_runner` role, or by scripts/install-system.sh on a hand-converged host.
#
# Delegate=yes is required: the runner creates a delegated cgroup v2 subtree to
# enforce sandbox cpu/memory/pids limits (ADR 006, ADR 012).
#
# Requires a dedicated vora system user, a rootless containerd socket owned by
# that user, and a lingering systemd --user manager for sandbox cgroups.
# CAP_SYS_ADMIN and CAP_NET_ADMIN are still needed for namespace and nft setup
# (and CAP_NET_BIND_SERVICE for the restricted-mode resolver on port 53);
# this unit does not make a compromised runner harmless.
[Unit]
Description=Vora runner
Documentation=https://github.com/vorash/vora
After=network-online.target containerd.service
Wants=network-online.target containerd.service
# With VORA_AUDIT_DSN set the runner refuses to start until the audit database
# is reachable. Keep retrying rather than tripping the default start limit (5
# starts in 10s), so a slow database means a late runner, not a dead one.
StartLimitIntervalSec=0

[Service]
Type=simple
User=vora
Group=vora
# No XDG_RUNTIME_DIR here: %U is the service manager's uid (0), not vora's.
# The runner defaults it to /run/user/<its uid>, where the user bus and the
# rootless containerd socket live.
Environment=VORA_SYSTEMD_MODE=user VORA_STATE_DIR=/var/lib/vora VORA_SOCKET=/run/vora/runner.sock
EnvironmentFile=/etc/vora/runner.env
ExecStart=/usr/local/bin/vora-runner
Restart=on-failure
RestartSec=2
TimeoutSec=0
KillMode=mixed
Delegate=yes

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/vora /run/vora
BindPaths=/run/vora/netns:/run/netns
# read-only, not yes: yes hides /run/user, and with it vora's user bus and
# rootless containerd socket (connecting to a socket needs no write access).
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# The bwrap launcher clears these before running bwrap (setpriv, util-linux):
# bwrap aborts when it holds capabilities without being setuid.
# CAP_NET_BIND_SERVICE: restricted sandboxes' DNS resolver listens on port 53
# of their gateway address.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_NET_BIND_SERVICE
UMask=0077

# Sandboxes carry their own pids/memory limits; the runner is long-lived and
# manages many of them, so it must not be capped by the unit.
TasksMax=infinity
LimitNOFILE=1048576

# The control socket is expected at /var/run/vora/runner.sock.
RuntimeDirectory=vora vora/netns
RuntimeDirectoryMode=0750
StateDirectory=vora
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
